# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Zona horaria de la barbería ────────────────────────────────────────────
# Fuente única para toda hora que se muestra o se guarda. Si algún día mueves
# el negocio, cámbiala aquí y en el proyecto del panel del barbero.
NEXT_PUBLIC_SHOP_TIMEZONE=America/Puerto_Rico

# ── Correos de citas (Resend) ──────────────────────────────────────────────
# Opcional: sin esto la app funciona igual, solo no manda correos.
# Ver supabase/CONFIGURACION.md, sección 3.
RESEND_API_KEY=
EMAIL_FROM=Amado Blends <citas@tudominio.com>
# Respaldo. Lo normal es ponerlo en Panel → Negocio → Correo para notificaciones.
BARBER_NOTIFY_EMAIL=
